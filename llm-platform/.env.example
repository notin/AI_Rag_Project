# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Postgres ----
# Option A — Supabase (recommended for hosted / sharing):
# Use the connection pooler (transaction mode, port 6543).
# Format: postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
#
# Option B — Local Docker (docker compose up):
# POSTGRES_USER=llm
# POSTGRES_PASSWORD=llm
# POSTGRES_DB=llm_platform
# DATABASE_URL=postgresql://llm:llm@localhost:5432/llm_platform

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- LLM transport ----
# openrouter = call OpenRouter directly from the app (no Docker/LiteLLM needed)
# gateway   = call local LiteLLM on LLM_GATEWAY_URL
LLM_TRANSPORT=openrouter

# ---- LiteLLM gateway (required when LLM_TRANSPORT=gateway) ----
LITELLM_MASTER_KEY=sk-local-master-key-change-me
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=sk-local-master-key-change-me

# ---- Providers ----
# Required when LLM_TRANSPORT=openrouter (also passed to LiteLLM when using gateway)
OPENROUTER_API_KEY=sk-or-v1-...
# Embeddings via OpenAI (gateway mode) / optional for OpenRouter openai/* models
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# ---- Rerank (used from Stage 3) ----
COHERE_API_KEY=

# ---- Retrieval / graph arm (Stage 3) ----
# Per-arm weights in the RRF sum. Set an arm to 0 to drop it from fusion.
RRF_WEIGHT_SEMANTIC=1
RRF_WEIGHT_KEYWORD=1
RRF_WEIGHT_GRAPH=1
# Master switch for everything the graph contributes. false = two-arm baseline,
# which is the control side of the Stage 6 A/B.
GRAPH_ARM_ENABLED=true
# Prepend the graph fact + matchup block to the prompt. Independent of the
# expansion arm above, so a win can be attributed to one or the other.
GRAPH_FACTS_ENABLED=true
# How many semantic hits seed the traversal, and how far it walks.
GRAPH_SEED_K=5
GRAPH_MAX_HOPS=2
GRAPH_MAX_WALK_SEEDS=12
GRAPH_MAX_NODES=32
GRAPH_MAX_NODES_PER_HOP=12
# How many reached entities a chunk must mention before the graph arm returns
# it. Tune against your corpus: the useful value scales with how many entities
# a chunk mentions, so a bar that filters one corpus is inert on another.
GRAPH_MIN_SHARED_ENTITIES=2
